# پایگاه داده‌ی Upstash Redis. وقتی Upstash رو از بخش Storage ورسل وصل کنید، این‌ها خودکار ساخته می‌شن.
# بدون این‌ها اپ در حالت «فقط همین دستگاه» کار می‌کنه.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# فقط برای توسعه‌ی محلی: ذخیره‌ی موقت در حافظه به جای Upstash. در محیط production نادیده گرفته می‌شه.
# SPR_DEV_MEMORY=1
