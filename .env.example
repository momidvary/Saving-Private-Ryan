# پایگاه داده‌ی Upstash Redis. وقتی Upstash رو از بخش Storage ورسل وصل کنید، این‌ها خودکار ساخته می‌شن.
# بدون این‌ها اپ در حالت «فقط همین دستگاه» کار می‌کنه.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# فقط برای توسعه‌ی محلی: ذخیره‌ی موقت در حافظه به جای Upstash. در محیط production نادیده گرفته می‌شه.
# SPR_DEV_MEMORY=1

# مشاور رایان (اختیاری). هر سرویسی که API سازگار با OpenAI داره.
# تا وقتی این‌ها خالی‌ان، بخش مشاور خاموشه. این مقادیر فقط در سرور خونده می‌شن؛ هیچ‌وقت پیشوند NEXT_PUBLIC_ نذارید.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=30
